/.claude
/.venv

# macOS
**/.DS_Store

# Python cache
**/__pycache__/

# training/: manter subpastas, ignorar ficheiros de resultados, mas guardar .py e .ipynb
training/**
!training/**/
!training/*.py
!training/*.ipynb
!training/**/.gitkeep

# instances/: manter subpastas, ignorar ficheiros lá dentro, exceto instances_test e instances_extra
instances/**
!instances/**/
!instances/**/.gitkeep
!instances/instances_test/**
!instances/instances_extra/**
